# Documentation only: the launcher does not load .env files automatically.
# Copy no real values into tracked files. Use scripts/start-stripe-test.cmd prompts.
CAP_STRIPE_TEST_ENABLED=false
CAP_STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_LOCALLY
CAP_STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE_LOCALLY
CAP_STRIPE_TEST_PRICE_ID=price_REPLACE
CAP_STRIPE_TEST_PORTAL_CONFIGURATION_ID=bpc_REPLACE
CAP_STRIPE_TEST_BASE_URL=http://127.0.0.1:8081
# setup-stripe-catalog.cmd writes non-secret IDs to ignored .local/stripe-test-catalog.json.
# The test launcher reads that map and enables paid group booking tests.
CAP_STRIPE_TEST_PRICES={}
CAP_TEST_PAID_BOOKINGS=false
# Explicit permission for at most two coach login emails; empty denies everyone.
CAP_MEMBERSHIP_REVIEWER_EMAILS=
